{
  "name": "marquand-catalogs",
  "version": "1.0.0",
  "description": "Static site for Marquand Auction Catalogs",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier . --write",
    "lint": "eslint -c eslint.config.js",
    "prepare": "simple-git-hooks",
    "test": "vitest --environment happy-dom",
    "start": "vite"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@honeybadger-io/js": "^6.16.5",
    "@honeybadger-io/vue": "^6.2.22",
    "bootstrap": "^5.3.3",
    "lux-design-system": "^7.14.1",
    "papaparse": "^5.4.1",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "happy-dom": "^21.0.4",
    "lint-staged": "^15.2.2",
    "msw": "^2.3.0",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.11.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.2"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,vue}": [
      "prettier --write",
      "eslint"
    ],
    "*.ts?(x)": [
      "eslint",
      "prettier --parser=typescript --write"
    ]
  }
}
